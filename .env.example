# KyrgyzSTEM configuration. Copy to .env (development) or deploy/.env.production
# (staging/production) and fill in the values. Never commit the copy.
# Every value below is a placeholder: generate real secrets, e.g.
#   python -c "import secrets; print(secrets.token_hex(24))"
# Use URL-safe characters (letters, digits) for POSTGRES_PASSWORD: it is embedded in a URL.

# --- Environment -----------------------------------------------------------------------
# development | test | production. production disables /api/v1/docs, refuses to start
# without SESSION_COOKIE_SECURE=true, and the seed script refuses to run.
APP_ENV=development

# --- PostgreSQL --------------------------------------------------------------------------
# docker compose creates the database from these.
POSTGRES_USER=kyrgyzstem
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=kyrgyzstem
# Host port for the development database (docker-compose.yml); change if 5432 is taken.
POSTGRES_HOST_PORT=5432
# Used when the API runs outside Docker (uv run ...). Compose builds its own URL.
DATABASE_URL=postgresql+psycopg://kyrgyzstem:replace-with-a-generated-password@localhost:5432/kyrgyzstem
# API test suite only: a DISPOSABLE database, wiped on every pytest run.
# TEST_DATABASE_URL=postgresql+psycopg://kyrgyzstem:replace-with-a-generated-password@localhost:5432/kyrgyzstem_test

# --- Sessions ----------------------------------------------------------------------------
# true anywhere served over HTTPS; required when APP_ENV=production.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=336
# A session unused for this long ends (audit F-16).
SESSION_IDLE_HOURS=168
# How long an admin-issued password reset link works, in minutes (5-1440).
PASSWORD_RESET_TTL_MINUTES=60

# --- Web -> API --------------------------------------------------------------------------
# Server-side only, baked into the Next.js build (rewrites are resolved at build time).
API_INTERNAL_URL=http://localhost:8000
# Vercel only (docs/DEPLOYMENT.md, "Vercel frontend with an API gateway"); leave unset
# everywhere else. Set both in Vercel's environment variables (the secret as Sensitive),
# and the same secret on the gateway host. Secret: 32+ letters, digits, '-' or '_'.
# API_GATEWAY_URL=https://api.example.org
# API_GATEWAY_SECRET=

# --- Rate limits, client address, connection pool ----------------------------------------
# memory: per process (one API worker; docker-compose). postgres: shared by every instance,
# required on Vercel, and then RATE_LIMIT_KEY_SECRET (32+ letters, digits, '-' or '_').
RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_KEY_SECRET=
# socket (default): uvicorn resolves X-Forwarded-For from --forwarded-allow-ips only.
# vercel: Vercel's x-forwarded-for; allowed only when Vercel sets VERCEL=1 (never set it
# yourself). docs/DEPLOYMENT.md "Vercel-only deployment".
CLIENT_IP_SOURCE=socket
# Per process. On Vercel keep them small (e.g. 2 and 3); set
# DATABASE_PREPARED_STATEMENTS=false if a transaction-mode pooler rejects prepared statements.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_PREPARED_STATEMENTS=true
# The postgres limiter's own fixed pool (separate from the request pool, which an
# authenticated request still holds while it is limited) and how long a hit may wait for
# one of its connections before failing with 503.
RATE_LIMIT_POOL_SIZE=2
RATE_LIMIT_POOL_TIMEOUT_SECONDS=5

# --- Logging -----------------------------------------------------------------------------
# JSON lines on stderr; "text" is easier to read locally. Logs never contain request
# bodies, cookies, tokens, IP addresses or query strings.
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Development seed --------------------------------------------------------------------
# Password for the synthetic @example.com accounts. Development only: the seed refuses
# to run when APP_ENV=production. Leave empty in staging/production.
SEED_PASSWORD=

# --- Production only (deploy/docker-compose.prod.yml) ----------------------------------
# Public host name; Caddy obtains a TLS certificate for it. http://localhost only for
# smoke tests.
SITE_ADDRESS=kyrgyzstem.example.org
# Image tag for this release (git tag). Keep the previous tag for rollback.
RELEASE_TAG=v0.1.0
# Host directory for deploy/backup.sh dumps (relative to the repository root, or absolute).
# Prefer a path outside the checkout, and copy dumps off the host (docs/OPERATIONS.md).
BACKUP_DIR=deploy/backups

# --- Judge0 (read by the judge worker only, never by the API; docs/DEPLOYMENT.md §7) ------
# Empty URL: the worker refuses to start. A plain base URL (no credentials or query);
# production requires the token. Use https:// across any network you do not control.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
# Language ids come from the installation's GET /languages; there are no defaults (empty
# means unset). Factors scale the problem's limits per language.
JUDGE0_TIMEOUT_SECONDS=10
JUDGE0_POLL_SECONDS=1
JUDGE0_MAX_WAIT_SECONDS=300
JUDGE0_LANGUAGE_ID_CPP=
JUDGE0_LANGUAGE_ID_PYTHON=
JUDGE0_TIME_FACTOR_CPP=1
JUDGE0_TIME_FACTOR_PYTHON=1
JUDGE0_MEMORY_FACTOR_CPP=1
JUDGE0_MEMORY_FACTOR_PYTHON=1
JUDGE0_WALL_TIME_FACTOR=3
JUDGE0_MAX_OUTPUT_BYTES=1048576
JUDGE0_MAX_RESPONSE_BYTES=16777216

# --- Optional AI assistant (docs/proposals/0004) -----------------------------------------
# Leave LLM_PROVIDER empty to disable it; the platform then serves authored hints only.
# The key stays on the server. Check the provider's data-retention terms before enabling
# it for minors.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=30
LLM_RELIABLE_LOCALES=en,ru
AI_DAILY_QUOTA_PER_USER=20
AI_GLOBAL_DAILY_CAP=1000
AI_MONTHLY_BUDGET_USD=25

# --- School operations (docs/SCHOOL_OPERATIONS.md) ---------------------------------------
ATTENDANCE_RETENTION_DAYS=365
JOIN_CODE_TTL_DAYS=7

# --- Judge queue (Step 5.3; no judge runs yet) -------------------------------------------
# Lease 30-600 s; renewal 5 s up to half the lease; attempts 1-10; poll 0.5-60 s;
# judging deadline 60-21600 s (no new test of a submission starts after it; retried).
JUDGE_LEASE_SECONDS=120
JUDGE_RENEW_SECONDS=30
JUDGE_MAX_ATTEMPTS=3
JUDGE_POLL_SECONDS=2
JUDGE_MAX_JUDGING_SECONDS=1800
# Persistent worker (python -m scripts.judge_worker): backoff 1-600 s (at least the poll
# interval); shutdown grace 0-600 s; health file for --check alive|ready (empty: none).
JUDGE_BACKOFF_MAX_SECONDS=60
JUDGE_SHUTDOWN_GRACE_SECONDS=30
JUDGE_WORKER_HEALTH_FILE=
# API side: languages queued for judging (comma list of cpp, python). Empty: nothing is
# queued and every submission is stored as not_judged. Set only with a running worker.
JUDGE_LANGUAGES=
